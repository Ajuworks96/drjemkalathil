        "default_value": "Curative Cytoreduction",
        "show_in_rest": 1
      },
      {
        "key": "field_specialty_3_title",
        "label": "Specialty 3 Title",
        "name": "specialty_3_title",
        "type": "text",
        "default_value": "Robotic Surgical Oncology",
        "show_in_rest": 1
      },
      {
        "key": "field_specialty_3_subtitle",
